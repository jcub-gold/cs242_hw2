###############
# DEFINITIONS #
###############

# Bool
def tt   = \x.\y. x;
def ff   = \x.\y. y;

# Numeral
def succ  = \n.\f.\x. f (n f x);
def _0   = \f.\x. x;
def _1   = succ _0;
def _2   = succ _1;
def _3   = succ _2;
def _4   = succ _3;

# Pair
def pair = \x.\y.\f. f x y;
def fst  = tt;
def snd  = ff;

# List
def cons = \h.\t.\f.\x. f h (t f x);
def nil  = \f.\x. x;

##########
# PART 4 #
##########
# TASK: Implement the following functions.

# BEGIN_YOUR_CODE
# Helper Functions
def or = \x.\y. x tt y;
def and = \x.\y. x y ff;
def add = \x.\y. x succ y;
def not = \x. x ff tt;

def next_fib_pair_helper = \x.\y.\z. (pair z (add y z));
def next_fib_pair = \x. next_fib_pair_helper pair (x fst) (x snd);

def next_dec_pair_helper = \x.\y.\z. (pair z (add _1 z));
def next_dec_pair = \x. next_dec_pair_helper pair (x fst) (x snd);

def is_odd = \n. n not ff;
def inc = \n. and (not (is_zero n)) (not (is_odd n));
def next_half_pair_helper = \x.\y.\z. (pair (pair (add y _1) y (inc z)) (add z _1));
def next_half_pair = \x. next_half_pair_helper pair (x fst) (x snd);


def is_zero  = pair (and ff) tt;
def len      = pair (\x.\y. succ y) _0;
def num_zero = pair (\x.\y. (is_zero x) (succ y) y) _0;
def fib      = \n. (n next_fib_pair (pair _1 _2)) fst;
def dec      = \n. (n next_dec_pair (pair _0 _0)) fst;
def half     = \n. (n next_half_pair (pair _0 _0)) fst;
# END_YOUR_CODE

#########
# TESTS #
#########
# NOTE: Expected outputs are given as comments on each line.

helper_section_or;
(or tt tt) x y;  # x
(or tt ff) x y;  # x
(or ff tt) x y;  # x
(or ff ff) x y;  # y

helper_section_and;
(or tt tt) x y;  # x
(or tt ff) x y;  # y
(or ff tt) x y;  # y
(or ff ff) x y;  # y

helper_section_add;
(add _0 _0) f x;  # x
(add _0 _1) f x;  # (f x)
(add _1 _1) f x;  # (f (f x))
(add _1 _2) f x;  # (f (f (f x)))

section_is_zero; # This symbol will just be printed, so we can keep track of the output.
(is_zero _0) x y;  # x
(is_zero _1) x y;  # y
(is_zero _2) x y;  # y
(is_zero _3) x y;  # y

section_len;
(len nil) f x;                                # x
(len (cons tt nil)) f x;                      # (f x)
(len (cons tt (cons ff nil))) f x;            # (f (f x))
(len (cons tt (cons ff (cons tt nil)))) f x;  # (f (f (f x)))

section_num_zero;
(num_zero nil) f x;                      # x
(num_zero (cons _1 nil)) f x;            # x
(num_zero (cons _0 nil)) f x;            # (f x)
(num_zero (cons _0 (cons _1 nil))) f x;  # (f x)
(num_zero (cons _0 (cons _0 nil))) f x;  # (f (f x))

section_fib;
(fib _0) f x;  # (f x)
(fib _1) f x;  # (f (f x))
(fib _2) f x;  # (f (f (f x)))
(fib _3) f x;  # (f (f (f (f (f x)))))
(fib _4) f x;  # (f (f (f (f (f (f (f (f x))))))))

section_dec;
(dec _0) f x;  # x
(dec _1) f x;  # x
(dec _2) f x;  # (f x)
(dec _3) f x;  # (f (f x))
(dec _4) f x;  # (f (f (f x)))

section_half;
(half _0) f x;  # x
(half _1) f x;  # x
(half _2) f x;  # (f x)
(half _3) f x;  # (f x)
(half _4) f x;  # (f (f x))
